---
// src/components/ConsentBanner.astro
//
// Cookie / analytics consent banner. Mounted once from BaseLayout.
//
// Behaviour (see src/lib/consent.ts for the pure logic and tests):
//  - Google Consent Mode v2 defaults are all "denied" before anything else.
//  - Google Tag Manager (GA4) and Microsoft Clarity are NOT loaded until the
//    visitor accepts analytics
//    ("basic" consent mode — no cookieless pings before consent).
//  - "Accept" and "Reject" are identical in size and style on purpose.
//  - A Global Privacy Control signal is honored as a rejection, silently.
//  - The choice is kept in localStorage for 12 months; the footer's
//    "Cookie Settings" button (any element with [data-consent-open]) reopens it.
import { site } from "../data/site";
---

<div
  id="consent-banner"
  data-gtm-id={site.gtmId}
  data-clarity-id={site.clarityId}
  role="dialog"
  aria-labelledby="consent-title"
  aria-describedby="consent-desc"
  hidden
  class="fixed inset-x-3 bottom-3 z-[100] sm:inset-x-auto sm:left-4 sm:bottom-4 sm:max-w-md rounded-card border border-brand-border bg-white p-5 text-navy shadow-[var(--shadow-lift)]"
>
  <h2 id="consent-title" class="font-serif text-lg text-navy">Your privacy choices</h2>
  <p id="consent-desc" class="mt-2 text-sm leading-relaxed text-brand-muted">
    We use essential storage to run this site. With your permission we also use Google
    Analytics and Microsoft Clarity to see which pages guests find useful and how the site
    is used. Choose "Accept" to allow analytics or
    "Reject" to decline. We never use advertising cookies.
    See our <a href="/privacy-policy/" class="underline text-seafoam">Privacy Policy</a>.
  </p>

  <div id="consent-details" hidden class="mt-4 space-y-3 border-t border-brand-border pt-4 text-sm">
    <div class="flex items-start justify-between gap-4">
      <div>
        <p class="font-semibold text-navy">Strictly necessary</p>
        <p class="text-brand-muted">Remembers this choice. Always on.</p>
      </div>
      <span class="shrink-0 text-xs font-semibold uppercase tracking-wide text-brand-muted">Always on</span>
    </div>
    <label class="flex cursor-pointer items-start justify-between gap-4">
      <span>
        <span class="block font-semibold text-navy">Analytics</span>
        <span class="block text-brand-muted">Google Analytics 4 (usage statistics) and Microsoft Clarity (anonymized session recordings and heatmaps).</span>
      </span>
      <input
        id="consent-analytics"
        type="checkbox"
        class="mt-1 h-5 w-5 shrink-0 rounded border-brand-border accent-seafoam"
      />
    </label>
    <button type="button" id="consent-save" class="btn btn-primary w-full justify-center">Save my choices</button>
  </div>

  <div class="mt-4 grid grid-cols-2 gap-3">
    <button type="button" id="consent-reject" class="btn btn-primary justify-center">Reject</button>
    <button type="button" id="consent-accept" class="btn btn-primary justify-center">Accept</button>
  </div>
  <button
    type="button"
    id="consent-customize"
    aria-expanded="false"
    aria-controls="consent-details"
    class="mt-3 text-sm underline text-seafoam"
  >
    Customize
  </button>
</div>

<script>
  import {
    CONSENT_STORAGE_KEY,
    cookieDomainCandidates,
    hasGlobalPrivacyControl,
    isAnalyticsCookie,
    makeConsent,
    parseConsent,
    toGoogleConsent,
    type ConsentChoice,
  } from "../lib/consent";

  type DataLayerWindow = Window & { dataLayer?: unknown[] };
  const w = window as DataLayerWindow;

  const banner = document.getElementById("consent-banner") as HTMLElement | null;
  const gtmId = banner?.dataset.gtmId ?? "";
  const clarityId = banner?.dataset.clarityId ?? "";

  // --- storage (wrapped: Safari private mode / blocked storage can throw) ---
  function readStored(): ConsentChoice | null {
    try {
      return parseConsent(localStorage.getItem(CONSENT_STORAGE_KEY));
    } catch {
      return null;
    }
  }
  function writeStored(choice: ConsentChoice): void {
    try {
      localStorage.setItem(CONSENT_STORAGE_KEY, JSON.stringify(choice));
    } catch {
      /* choice still applies for this page view */
    }
  }

  // --- Google Consent Mode v2 ---
  w.dataLayer = w.dataLayer || [];
  function gtag(..._args: unknown[]): void {
    // Google's tag expects the `arguments` object itself, not an array.
    // eslint-disable-next-line prefer-rest-params
    w.dataLayer!.push(arguments);
  }

  let gtmLoaded = false;
  function loadGtm(): void {
    if (gtmLoaded || !gtmId) return;
    gtmLoaded = true;
    w.dataLayer!.push({ "gtm.start": Date.now(), event: "gtm.js" });
    const s = document.createElement("script");
    s.async = true;
    s.src = `https://www.googletagmanager.com/gtm.js?id=${encodeURIComponent(gtmId)}`;
    document.head.appendChild(s);
  }

  let clarityLoaded = false;
  function loadClarity(): void {
    if (clarityLoaded || !clarityId) return;
    clarityLoaded = true;
    // Microsoft's standard Clarity bootstrap, run only after opt-in.
    type ClarityFn = ((...a: unknown[]) => void) & { q?: unknown[] };
    const c = window as unknown as { clarity?: ClarityFn };
    c.clarity =
      c.clarity ||
      function (...a: unknown[]) {
        (c.clarity!.q = c.clarity!.q || []).push(a);
      };
    const t = document.createElement("script");
    t.async = true;
    t.src = `https://www.clarity.ms/tag/${encodeURIComponent(clarityId)}`;
    document.head.appendChild(t);
  }

  function loadAnalytics(): void {
    loadGtm();
    loadClarity();
  }

  function deleteAnalyticsCookies(): void {
    const names = document.cookie
      .split(";")
      .map((c) => c.split("=")[0].trim())
      .filter(isAnalyticsCookie);
    const hosts = cookieDomainCandidates(location.hostname);
    for (const name of names) {
      document.cookie = `${name}=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/`;
      for (const host of hosts) {
        document.cookie = `${name}=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/; domain=${host}`;
      }
    }
  }

  function apply(choice: ConsentChoice | null): void {
    gtag("consent", "update", toGoogleConsent(choice));
    if (choice?.analytics) {
      loadAnalytics();
    } else {
      deleteAnalyticsCookies();
    }
  }

  // Defaults first — before any Google script can exist on the page.
  const stored = readStored();
  gtag("consent", "default", toGoogleConsent(stored));
  if (stored?.analytics) loadAnalytics();

  // --- banner UI ---
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null;
  const details = $("consent-details");
  const customize = $("consent-customize");
  const analyticsBox = $<HTMLInputElement>("consent-analytics");

  function setDetails(open: boolean): void {
    if (!details || !customize) return;
    details.hidden = !open;
    customize.setAttribute("aria-expanded", String(open));
    customize.textContent = open ? "Hide options" : "Customize";
  }

  function show(opts: { expanded: boolean; focus: boolean }): void {
    if (!banner) return;
    if (analyticsBox) analyticsBox.checked = readStored()?.analytics ?? false;
    setDetails(opts.expanded);
    banner.hidden = false;
    if (opts.focus) $("consent-title")?.setAttribute("tabindex", "-1"), $("consent-title")?.focus();
  }

  function decide(analytics: boolean): void {
    const choice = makeConsent(analytics, "user");
    writeStored(choice);
    apply(choice);
    if (banner) banner.hidden = true;
  }

  $("consent-accept")?.addEventListener("click", () => decide(true));
  $("consent-reject")?.addEventListener("click", () => decide(false));
  $("consent-save")?.addEventListener("click", () => decide(Boolean(analyticsBox?.checked)));
  customize?.addEventListener("click", () => setDetails(details?.hidden ?? true));

  // Footer "Cookie Settings" (or any [data-consent-open]) reopens the panel.
  document.addEventListener("click", (e) => {
    const trigger = (e.target as Element | null)?.closest("[data-consent-open]");
    if (!trigger) return;
    e.preventDefault();
    show({ expanded: true, focus: true });
  });

  // Escape dismisses the panel once a choice already exists.
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && banner && !banner.hidden && readStored()) banner.hidden = true;
  });

  // --- first visit ---
  if (!stored) {
    if (hasGlobalPrivacyControl(navigator as Navigator & { globalPrivacyControl?: boolean })) {
      // Honor the opt-out signal without nagging; the footer link still lets
      // the visitor opt in deliberately.
      const choice = makeConsent(false, "gpc");
      writeStored(choice);
      apply(choice);
    } else {
      show({ expanded: false, focus: false });
    }
  }
</script>
