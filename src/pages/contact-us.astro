---
// src/pages/contact-us.astro
import SiteLayout from "../layouts/SiteLayout.astro";
import Hero from "../components/Hero.astro";
import ContactForm from "../components/ContactForm.astro";
import { site } from "../data/site";
---

<SiteLayout
  title="Contact Us"
  description="Get in touch with Beachwalk Villas in Carlsbad, CA. Check villa availability, ask questions, or make a reservation inquiry. Call 760-720-1400 ext. 1."
>
  <Hero
    eyebrow="We're here to help"
    headline="Contact Us"
    subheadline="Reach out to check availability, ask a question, or book your beachfront escape."
    bgImage="/images/beachwalk-featured-images.jpg"
    size="medium"
  />

  <section class="section-pad bg-sand reveal">
    <div class="container-site">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
        <!-- Contact info sidebar -->
        <div class="lg:col-span-1 space-y-5">
          <div class="card p-7">
            <span class="eyebrow">Call us</span>
            <a
              href={site.phoneHref}
              class="block font-serif text-2xl text-navy hover:text-seafoam transition-colors mt-1 mb-1"
            >
              {site.phone}
            </a>
            <p class="text-sm text-brand-muted">We'd love to hear from you.</p>
          </div>

          <div class="card p-7">
            <h2 class="font-serif text-h3 mb-4">Get in touch</h2>
            <dl class="space-y-4 text-sm text-brand-muted">
              <div>
                <dt class="font-semibold text-navy mb-0.5">Email</dt>
                <dd>
                  <a href={site.emailHref} class="text-seafoam hover:underline">{site.email}</a>
                </dd>
              </div>
              <div>
                <dt class="font-semibold text-navy mb-0.5">Address</dt>
                <dd>
                  <a
                    href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(site.mapsQuery)}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hover:text-seafoam"
                  >
                    {site.address}
                  </a>
                  <span class="block text-brand-muted/80">Near Downtown Carlsbad</span>
                </dd>
              </div>
              <div>
                <dt class="font-semibold text-navy mb-0.5">Check-In</dt>
                <dd>4:00 PM</dd>
              </div>
              <div>
                <dt class="font-semibold text-navy mb-0.5">Check-Out</dt>
                <dd>11:00 AM</dd>
              </div>
            </dl>
          </div>

          <div class="card p-7">
            <h3 class="font-serif text-lg mb-3">Helpful links</h3>
            <ul class="space-y-2.5 text-sm">
              <li><a href="/villas/" class="text-seafoam hover:underline">Browse all villas</a></li>
              <li><a href="/amenities/" class="text-seafoam hover:underline">Property amenities</a></li>
              <li><a href="/reservation-policies/" class="text-seafoam hover:underline">Reservation policies</a></li>
              <li><a href="/promotions/" class="text-seafoam hover:underline">Current promotions</a></li>
            </ul>
          </div>
        </div>

        <!-- Contact form -->
        <div class="lg:col-span-2">
          <ContactForm title="Send us a message" showVillaSelect={true} />
        </div>
      </div>
    </div>
  </section>

  <!-- Rounded map embed -->
  <section class="bg-brand-surface pb-20 reveal">
    <div class="container-site">
      <div class="overflow-hidden rounded-card shadow-[var(--shadow-soft)] border border-brand-border">
        <!-- Click-to-load: Google is not contacted until the visitor asks for the map. -->
        <div
          id="map-embed"
          data-src={`https://www.google.com/maps?q=${encodeURIComponent(site.mapsQuery)}&output=embed`}
          data-title="Map of Beachwalk Villas — 3100 Ocean St, Carlsbad, CA"
          class="flex h-[420px] flex-col items-center justify-center gap-4 bg-sand px-6 text-center"
        >
          <p class="max-w-md text-sm text-brand-muted">
            Loading the interactive map connects your browser to Google, which may set cookies.
            See our <a href="/privacy-policy/" class="underline text-seafoam">Privacy Policy</a>.
          </p>
          <button type="button" id="map-load" class="btn btn-primary">Load interactive map</button>
          <a
            href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(site.mapsQuery)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm underline text-seafoam"
          >
            Or open in Google Maps
          </a>
        </div>
      </div>
    </div>
  </section>
</SiteLayout>

<script>
  const holder = document.getElementById("map-embed");
  document.getElementById("map-load")?.addEventListener("click", () => {
    if (!holder) return;
    const frame = document.createElement("iframe");
    frame.title = holder.dataset.title ?? "Map";
    frame.src = holder.dataset.src ?? "";
    frame.width = "100%";
    frame.height = "420";
    frame.style.border = "0";
    frame.referrerPolicy = "no-referrer-when-downgrade";
    frame.allowFullscreen = true;
    holder.replaceWith(frame);
  });
</script>
