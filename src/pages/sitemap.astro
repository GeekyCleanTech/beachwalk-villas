---
// src/pages/sitemap.astro — human-readable site map (companion to the XML
// sitemap generated by @astrojs/sitemap at build time).
import SiteLayout from "../layouts/SiteLayout.astro";
import { getCollection } from "astro:content";
import { navLinks, footerLinks, categoryLabels, bedroomCategory } from "../data/site";

const villas = (await getCollection("villas")).sort(
  (a, b) => a.data.sortOrder - b.data.sortOrder,
);

const mainPages = [
  ...navLinks.filter((l) => l.href !== "/villas/"),
  ...footerLinks,
];

const villaGroups = categoryLabels
  .map(({ key, label }) => ({
    label,
    villas: villas.filter((v) => bedroomCategory(v.data.specs.bedrooms) === key),
  }))
  .filter((g) => g.villas.length > 0);
---

<SiteLayout
  title="Site Map"
  description="Site map for Beachwalk Villas in Carlsbad, CA — every page, villa, and policy in one place."
>
  <section class="section-pad bg-sand">
    <div class="container-site max-w-3xl">
      <div class="prose-coastal">
        <h1 class="font-serif text-h2 text-navy">Site Map</h1>
        <p class="text-gray-600">
          Every page on the Beachwalk Villas website, in one place.
        </p>

        <h2 class="font-serif text-h3 text-navy mt-8">Main Pages</h2>
        <ul class="space-y-2 text-gray-600">
          {
            mainPages.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
        </ul>

        <h2 class="font-serif text-h3 text-navy mt-8">
          <a href="/villas/">Our Villas</a>
        </h2>
        {
          villaGroups.map((group) => (
            <>
              <h3 class="font-serif text-lg text-navy mt-6">{group.label}</h3>
              <ul class="space-y-2 text-gray-600">
                {group.villas.map((villa) => (
                  <li>
                    <a href={`/villas/${villa.id}/`}>{villa.data.name}</a>
                  </li>
                ))}
              </ul>
            </>
          ))
        }
      </div>
    </div>
  </section>
</SiteLayout>
